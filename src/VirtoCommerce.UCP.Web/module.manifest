<?xml version="1.0" encoding="utf-8"?>
<module>
  <id>VirtoCommerce.UCP</id>
  <version>3.1006.0</version>
  <version-tag></version-tag>

  <platformVersion>3.1066.0-alpha.13384-vcst-5378-unified-buyer-flow</platformVersion>
  <dependencies>
    <dependency id="VirtoCommerce.Xapi" version="3.1015.0" />
    <dependency id="VirtoCommerce.XCatalog" version="3.1000.0" />
    <dependency id="VirtoCommerce.XCart" version="3.1016.0" />
    <dependency id="VirtoCommerce.Store" version="3.1004.0" />
    <dependency id="VirtoCommerce.Orders" version="3.1000.0" />
    <dependency id="VirtoCommerce.Marketing" version="3.1000.0" />
    <dependency id="VirtoCommerce.ApplicationInsights" version="3.1004.0" optional="true" />
    <dependency id="VirtoCommerce.OpenTelemetry" version="3.1001.0" optional="true" />
  </dependencies>

  <title>Universal Commerce Protocol</title>
  <description>Universal Commerce Protocol facade for Virto Commerce capabilities.</description>

  <authors>
    <author>VirtoCommerce</author>
  </authors>
  <owners>
    <owner>VirtoCommerce</owner>
  </owners>

  <groups>
    <group>commerce</group>
  </groups>

  <projectUrl>https://github.com/VirtoCommerce/vc-module-u-c-p</projectUrl>
  <iconUrl>Modules/$(VirtoCommerce.UCP)/Content/logo.svg</iconUrl>
  <requireLicenseAcceptance>false</requireLicenseAcceptance>

  <assemblyFile>VirtoCommerce.UCP.Web.dll</assemblyFile>
  <moduleType>VirtoCommerce.UCP.Web.Module, VirtoCommerce.UCP.Web</moduleType>
  <startupType>VirtoCommerce.UCP.Web.UcpMcpStartup, VirtoCommerce.UCP.Web</startupType>

  <releaseNotes>Adds MCP-to-UCP-to-XAPI tracing, metrics, and AI-visible correlation. Breaking changes: REST XAPI failures now return HTTP 200 with the original GraphQL envelope instead of a synthetic 502; MCP UCP failures now return tools/call isError results instead of JSON-RPC errors; protected ParseGraphQlResult and CreateException overloads remain compatible.</releaseNotes>
  <copyright>Copyright © 2026 VirtoCommerce. All rights reserved</copyright>
  <tags>ucp commerce mcp checkout catalog cart</tags>
  <useFullTypeNameInSwagger>false</useFullTypeNameInSwagger>
</module>
