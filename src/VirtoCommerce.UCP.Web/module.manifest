<?xml version="1.0" encoding="utf-8"?>
<module>
  <id>VirtoCommerce.UCP</id>
  <version>3.1011.0</version>
  <version-tag></version-tag>

  <platformVersion>3.1085.0</platformVersion>
  <dependencies>
    <dependency id="VirtoCommerce.MCP" version="3.1000.0-alpha.15-vcst-6155-core-mcp-module" />
    <dependency id="VirtoCommerce.Xapi" version="3.1026.0" />
    <dependency id="VirtoCommerce.XCatalog" version="3.1023.0" />
    <dependency id="VirtoCommerce.XCart" version="3.1038.0" />
    <dependency id="VirtoCommerce.XOrder" version="3.1014.0" />
    <dependency id="VirtoCommerce.Store" version="3.1009.0" />
    <dependency id="VirtoCommerce.Orders" version="3.1018.0" />
    <dependency id="VirtoCommerce.Marketing" version="3.1009.0" />
    <dependency id="VirtoCommerce.OpenTelemetry" version="3.1002.0" optional="true" />
  </dependencies>

  <title>Universal Commerce Protocol</title>
  <description>Universal Commerce Protocol facade for Virto Commerce capabilities.</description>

  <authors>
    <author>VirtoCommerce</author>
  </authors>
  <owners>
    <owner>VirtoCommerce</owner>
  </owners>

  <groups>
    <group>commerce</group>
  </groups>

  <projectUrl>https://github.com/VirtoCommerce/vc-module-ucp</projectUrl>
  <iconUrl>Modules/$(VirtoCommerce.UCP)/Content/logo.svg</iconUrl>
  <requireLicenseAcceptance>false</requireLicenseAcceptance>

  <assemblyFile>VirtoCommerce.UCP.Web.dll</assemblyFile>
  <moduleType>VirtoCommerce.UCP.Web.Module, VirtoCommerce.UCP.Web</moduleType>

  <releaseNotes>The buyer MCP endpoint /ucp/mcp is served by the MCP module (VirtoCommerce.MCP) as the ucp scope: sign-in and token checks, tool switches, the audit log and connected agents in the back office, and one trace per call from the MCP tool span through UCP to XAPI. Breaking changes: requires the MCP module and platform 3.1085.0; the Application Insights compatibility bridge and UCP:Observability:EnableApplicationInsightsCompatibilityBridge are removed (send telemetry with the OpenTelemetry module, OpenTelemetry:AzureMonitor:ConnectionString); UcpMcpStartup, UcpMcpSessionService, UcpMcpBuyerAuthenticationMiddleware, UcpOAuthMetadataController, UcpProtectedResourceMetadata, UcpMcpActivityStatusFilter and UcpApplicationInsightsActivityBridge are removed; REST XAPI failures return HTTP 200 with the original GraphQL envelope, and MCP failures return tools/call isError results.</releaseNotes>
  <copyright>Copyright © 2026 VirtoCommerce. All rights reserved</copyright>
  <tags>ucp commerce mcp checkout catalog cart</tags>
  <useFullTypeNameInSwagger>false</useFullTypeNameInSwagger>
</module>
